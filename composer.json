{
    "name": "setono/sylius-gift-card-plugin",
    "description": "Gift card plugin for Sylius",
    "license": "MIT",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "gift-card",
        "setono"
    ],
    "require": {
        "php": ">=8.1",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "doctrine/collections": "^1.8 || ^2.0",
        "doctrine/orm": "^2.14",
        "doctrine/persistence": "^2.5 || ^3.0",
        "dompdf/dompdf": "^2.0 || ^3.0",
        "fakerphp/faker": "^1.21",
        "knplabs/knp-menu": "^3.3",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "setono/doctrine-orm-trait": "^1.4",
        "sylius/channel": "^1.0",
        "sylius/channel-bundle": "^1.0",
        "sylius/core": "^1.0",
        "sylius/core-bundle": "^1.0",
        "sylius/currency": "^1.0",
        "sylius/customer": "^1.0",
        "sylius/grid-bundle": "^1.11",
        "sylius/locale": "^1.0",
        "sylius/mailer-bundle": "^1.8 || ^2.0",
        "sylius/money-bundle": "^1.0",
        "sylius/order": "^1.0",
        "sylius/order-bundle": "^1.0",
        "sylius/payment": "^1.0",
        "sylius/product": "^1.0",
        "sylius/product-bundle": "^1.0",
        "sylius/promotion": "^1.0",
        "sylius/resource-bundle": "^1.11",
        "sylius/state-machine-abstraction": "^1.13",
        "sylius/ui-bundle": "^1.0",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/doctrine-bridge": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/form": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/options-resolver": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/security-csrf": "^6.4",
        "symfony/translation": "^6.4",
        "symfony/translation-contracts": "^2.4 || ^3.0",
        "symfony/validator": "^6.4",
        "symfony/workflow": "^6.4",
        "twig/twig": "^2.15 || ^3.5",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "babdev/pagerfanta-bundle": "^3.8",
        "doctrine/doctrine-bundle": "^2.7",
        "matthiasnoback/symfony-config-test": "^4.3 || ^5.1",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0.7",
        "setono/sylius-plugin-pack": "~1.14.1",
        "symfony/debug-bundle": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/intl": "^6.4",
        "symfony/web-profiler-bundle": "^6.4",
        "symfony/webpack-encore-bundle": "^1.17.2"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\SyliusGiftCardPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\SyliusGiftCardPlugin\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "symfony/thanks": false
        },
        "audit": {
            "block": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit"
    }
}
