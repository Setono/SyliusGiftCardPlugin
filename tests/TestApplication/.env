DATABASE_URL=mysql://root@127.0.0.1/setono_sylius_gift_card_plugin_%kernel.environment%

BEHAT_BASE_URL="https://127.0.0.1:8080/"
BEHAT_CHROME_URL="http://127.0.0.1:9222"

# Default to the standard apt install location (used by CI); override
# locally if wkhtmltopdf/wkhtmltoimage live somewhere else (e.g. Docker).
KNP_SNAPPY_PDF_BINARY=/usr/bin/wkhtmltopdf
KNP_SNAPPY_IMAGE_BINARY=/usr/bin/wkhtmltoimage

SYLIUS_TEST_APP_BUNDLES_REPLACE_PATH="tests/TestApplication/config/bundles.php"
SYLIUS_TEST_APP_CONFIGS_TO_IMPORT="../../../../tests/TestApplication/config/config.yaml"
SYLIUS_TEST_APP_ROUTES_TO_IMPORT="../../../../tests/TestApplication/config/routes.yaml"
