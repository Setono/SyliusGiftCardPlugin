<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedPsalmSuppress="false"
    findUnusedBaselineEntry="false"
    findUnusedVariablesAndParams="false"
    findUnusedCode="false"
    errorLevel="1"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <directory name="src"/>
        <!-- <directory name="tests"/> TODO Readd this -->
        <ignoreFiles>
            <directory name="src/Fixture"/>
            <directory name="tests/TestApplication"/>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
        <pluginClass class="Weirdan\DoctrinePsalmPlugin\Plugin"/>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin"/>
    </plugins>
    <forbiddenFunctions>
        <function name="dd"/>
        <function name="dump"/>
        <function name="var_dump"/>
        <function name="print_r"/>
    </forbiddenFunctions>
    <issueHandlers>
        <DeprecatedClass>
            <errorLevel type="suppress">
                <file name="src/DependencyInjection/SetonoSyliusGiftCardExtension.php"/>
            </errorLevel>
        </DeprecatedClass>
        <InvalidArgument>
            <errorLevel type="suppress">
                <file name="src/DependencyInjection/Configuration.php"/>
            </errorLevel>
        </InvalidArgument>
        <PluginIssue name="QueryBuilderSetParameter" errorLevel="suppress"/>
        <MissingTemplateParam>
            <errorLevel type="suppress">
                <directory name="src/Factory"/>
                <directory name="src/Form"/>
                <directory name="src/Repository"/>
                <directory name="src/Security"/>
            </errorLevel>
        </MissingTemplateParam>
        <RedundantConditionGivenDocblockType errorLevel="suppress"/>
    </issueHandlers>
</psalm>
