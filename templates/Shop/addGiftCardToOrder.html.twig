{% form_theme form '@SyliusShop/form/theme.html.twig' %}

<div class="mb-4">
    <div class="p-4 bg-light">
        {{ form_start(form, {
            'action': path('setono_sylius_gift_card_shop_partial_add_gift_card_to_order'),
            'attr': {'id': 'setono-sylius-gift-card-add-gift-card-to-order'},
        }) }}
        {{ form_row(form._token) }}
        {{ form_end(form, {'render_rest': false}) }}

        <div class="input-group field">
            {{ form_widget(form.giftCard, {'attr': {'form': 'setono-sylius-gift-card-add-gift-card-to-order', 'class': 'form-control'}}) }}
            <button type="submit" class="btn btn-outline-gray" form="setono-sylius-gift-card-add-gift-card-to-order">
                {{ 'setono_sylius_gift_card.ui.add_gift_card_to_order'|trans }}
            </button>
        </div>
        {{ form_errors(form.giftCard) }}
    </div>
</div>
