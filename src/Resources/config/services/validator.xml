<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\ValidGiftCardAmountValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\ValidGiftCardAmountValidator">
            <argument type="service" id="sylius.context.channel"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Provider\GiftCardAmountLimitsProviderInterface"/>
            <argument type="service" id="sylius.money_formatter"/>
            <argument type="service" id="sylius.context.locale"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <!-- Sylius' order totals are integer columns, and sylius_core.max_int_value is Sylius' setting for the most its
             integer columns hold -->
        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardFitsCartValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardFitsCartValidator">
            <argument>%sylius_core.max_int_value%</argument>
            <argument type="service" id="sylius.money_formatter"/>
            <argument type="service" id="sylius.context.locale"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardQuantityFitsCartValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardQuantityFitsCartValidator">
            <argument>%sylius_core.max_int_value%</argument>
            <argument type="service" id="sylius.money_formatter"/>
            <argument type="service" id="sylius.context.locale"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\BalanceAdjustmentIsEligibleValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\BalanceAdjustmentIsEligibleValidator">
            <argument type="service" id="sylius.money_formatter"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardCurrencyIsChannelBaseCurrencyValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardCurrencyIsChannelBaseCurrencyValidator">
            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\UniqueDesignImageTypesValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\UniqueDesignImageTypesValidator">
            <tag name="validator.constraint_validator"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardDesignRequiredValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardDesignRequiredValidator">
            <argument type="service" id="sylius.context.channel"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Provider\GiftCardDesignProviderInterface"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardDesignIsAvailableInChannelValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardDesignIsAvailableInChannelValidator">
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Provider\GiftCardDesignProviderInterface"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardCodeLengthValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardCodeLengthValidator">
            <argument>%setono_sylius_gift_card.minimum_code_length%</argument>

            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardMessageLengthValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardMessageLengthValidator">
            <argument>%setono_sylius_gift_card.purchase.maximum_message_length%</argument>

            <tag name="validator.constraint_validator"/>
        </service>

        <!-- Sylius' availability checker, which Sylius' own stock checks ask as well. The interface alias exists on
             Sylius 1.13 and 1.14, and on 1.14 it leads through sylius.checker.inventory.availability and
             sylius.availability_checker, so a decorator of either applies here too -->
        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardCartItemAvailabilityValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardCartItemAvailabilityValidator">
            <argument type="service" id="Sylius\Component\Inventory\Checker\AvailabilityCheckerInterface"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardOrderItemsAvailabilityValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardOrderItemsAvailabilityValidator">
            <argument type="service" id="Sylius\Component\Inventory\Checker\AvailabilityCheckerInterface"/>

            <tag name="validator.constraint_validator"/>
        </service>
    </services>
</container>
