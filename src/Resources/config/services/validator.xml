<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\ValidGiftCardAmountValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\ValidGiftCardAmountValidator">
            <argument type="service" id="sylius.context.channel"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Provider\GiftCardAmountLimitsProvider"/>
            <argument type="service" id="sylius.money_formatter"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\BalanceAdjustmentIsApplicableValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\BalanceAdjustmentIsApplicableValidator">
            <argument type="service" id="sylius.money_formatter"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardCurrencyIsChannelBaseCurrencyValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardCurrencyIsChannelBaseCurrencyValidator">
            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\UniqueDesignImageTypesValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\UniqueDesignImageTypesValidator">
            <tag name="validator.constraint_validator"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardDesignRequiredValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardDesignRequiredValidator">
            <argument type="service" id="sylius.context.channel"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Provider\GiftCardDesignProvider"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardMessageLengthValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardMessageLengthValidator">
            <argument>%setono_sylius_gift_card.purchase.maximum_message_length%</argument>

            <tag name="validator.constraint_validator"/>
        </service>
    </services>
</container>
