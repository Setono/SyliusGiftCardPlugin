<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults public="true"/>

        <service id="Setono\SyliusGiftCardPlugin\Controller\Action\AddGiftCardToOrderAction"
                 class="Setono\SyliusGiftCardPlugin\Controller\Action\AddGiftCardToOrderAction">
            <argument type="service" id="form.factory"/>
            <argument type="service" id="sylius.context.cart"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Applicator\GiftCardApplicator"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Resolver\RedirectUrlResolver"/>
            <argument type="service" id="doctrine"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Controller\Action\RemoveGiftCardFromOrderAction"
                 class="Setono\SyliusGiftCardPlugin\Controller\Action\RemoveGiftCardFromOrderAction">
            <argument type="service" id="sylius.context.cart"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Applicator\GiftCardApplicator"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Resolver\RedirectUrlResolver"/>
            <argument type="service" id="security.csrf.token_manager"/>
            <argument type="service" id="doctrine"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Controller\Action\DownloadGiftCardPdfAction"
                 class="Setono\SyliusGiftCardPlugin\Controller\Action\DownloadGiftCardPdfAction">
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card"/>
            <argument type="service" id="setono_sylius_gift_card.pdf.generator"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Controller\Action\Admin\PreviewGiftCardDesignPdfAction"
                 class="Setono\SyliusGiftCardPlugin\Controller\Action\Admin\PreviewGiftCardDesignPdfAction">
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card_design"/>
            <argument type="service" id="setono_sylius_gift_card.factory.gift_card"/>
            <argument type="service" id="setono_sylius_gift_card.pdf.generator"/>
            <argument type="service" id="sylius.context.channel"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Controller\Action\Admin\GiftCardBalanceAction"
                 class="Setono\SyliusGiftCardPlugin\Controller\Action\Admin\GiftCardBalanceAction">
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card"/>
            <argument type="service" id="twig"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Controller\Action\Admin\AdjustGiftCardBalanceAction"
                 class="Setono\SyliusGiftCardPlugin\Controller\Action\Admin\AdjustGiftCardBalanceAction">
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Operator\GiftCardBalanceOperator"/>
            <argument type="service" id="form.factory"/>
            <argument type="service" id="twig"/>
            <argument type="service" id="router"/>
            <argument type="service" id="doctrine"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Controller\Action\Admin\CreateGiftCardProductAction"
                 class="Setono\SyliusGiftCardPlugin\Controller\Action\Admin\CreateGiftCardProductAction">
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Fixture\Factory\GiftCardProductExampleFactory"/>
            <argument type="service" id="doctrine"/>
            <argument type="service" id="router"/>
        </service>
    </services>
</container>
