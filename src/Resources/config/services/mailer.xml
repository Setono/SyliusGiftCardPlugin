<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusGiftCardPlugin\Mailer\GiftCardEmailManager"
                 class="Setono\SyliusGiftCardPlugin\Mailer\GiftCardEmailManager">
            <argument type="service" id="sylius.email_sender"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Pdf\GiftCardPdfGeneratorInterface"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Mailer\GiftCardEmailManagerInterface"
                 alias="Setono\SyliusGiftCardPlugin\Mailer\GiftCardEmailManager"/>

        <service id="Setono\SyliusGiftCardPlugin\EventSubscriber\SendGiftCardEmailSubscriber"
                 class="Setono\SyliusGiftCardPlugin\EventSubscriber\SendGiftCardEmailSubscriber">
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Mailer\GiftCardEmailManager"/>

            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
