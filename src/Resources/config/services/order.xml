<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <parameters>
        <parameter key="setono_sylius_gift_card.order.model.gift_card_information.class">Setono\SyliusGiftCardPlugin\Order\GiftCardInformation</parameter>
        <parameter key="setono_sylius_gift_card.order.model.add_to_cart_command.class">Setono\SyliusGiftCardPlugin\Order\AddToCartCommand</parameter>
    </parameters>

    <services>
        <service id="Setono\SyliusGiftCardPlugin\Order\Factory\GiftCardInformationFactory"
                 class="Setono\SyliusGiftCardPlugin\Order\Factory\GiftCardInformationFactory">
            <argument>%setono_sylius_gift_card.order.model.gift_card_information.class%</argument>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Order\Factory\GiftCardInformationFactoryInterface"
                 alias="Setono\SyliusGiftCardPlugin\Order\Factory\GiftCardInformationFactory"/>

        <!-- decoration-priority is negative so this decorator is applied last (outermost): its idempotency check then
             sees whatever the rest of the chain produced and only wraps a command that is not yet gift card aware -->
        <service id="Setono\SyliusGiftCardPlugin\Order\Factory\AddToCartCommandFactory"
                 decorates="sylius.factory.add_to_cart_command" decoration-priority="-10">
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Order\Factory\AddToCartCommandFactory.inner"/>
            <argument>%setono_sylius_gift_card.order.model.add_to_cart_command.class%</argument>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Order\Factory\GiftCardInformationFactory"/>
        </service>
    </services>
</container>
