<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusGiftCardPlugin\Provider\GiftCardDesignProvider"
                 class="Setono\SyliusGiftCardPlugin\Provider\GiftCardDesignProvider">
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card_design"/>
            <argument type="service" id="setono_sylius_gift_card.factory.gift_card_design"/>
            <argument type="service" id="setono_sylius_gift_card.factory.gift_card_design_image"/>
            <argument type="service" id="sylius.image_uploader"/>
            <argument type="service" id="setono_sylius_gift_card.manager.gift_card_design"/>
            <argument>%setono_sylius_gift_card.default_design_image_path%</argument>
            <argument type="service" id="logger" on-invalid="null"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Provider\GiftCardDesignProviderInterface"
                 alias="Setono\SyliusGiftCardPlugin\Provider\GiftCardDesignProvider"/>

        <service id="Setono\SyliusGiftCardPlugin\Provider\GiftCardAmountLimitsProvider"
                 class="Setono\SyliusGiftCardPlugin\Provider\GiftCardAmountLimitsProvider">
            <argument>%setono_sylius_gift_card.purchase.minimum_amount%</argument>
            <argument>%setono_sylius_gift_card.purchase.maximum_amount%</argument>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Provider\GiftCardAmountLimitsProviderInterface"
                 alias="Setono\SyliusGiftCardPlugin\Provider\GiftCardAmountLimitsProvider"/>
    </services>
</container>
