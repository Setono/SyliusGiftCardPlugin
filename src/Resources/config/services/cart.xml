<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusGiftCardPlugin\Cart\CartGiftCardHandler">
            <argument type="service" id="setono_sylius_gift_card.factory.gift_card"/>
            <argument type="service" id="doctrine"/>
            <argument type="service" id="sylius.currency_converter"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Provider\GiftCardCurrencyProviderInterface"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Cart\CartGiftCardHandlerInterface"
                 alias="Setono\SyliusGiftCardPlugin\Cart\CartGiftCardHandler"/>

        <!-- Priority 45: right after Sylius' prices recalculator (50), which leaves the immutable gift card lines alone,
             so the line is priced before shipments (40), shipping charges (30), promotions (20) and taxes (10) are
             worked out from the cart -->
        <service id="Setono\SyliusGiftCardPlugin\OrderProcessor\GiftCardLineProcessor">
            <argument type="service" id="sylius.currency_converter"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Operator\OrderGiftCardOperatorInterface"/>

            <tag name="sylius.order_processor" priority="45"/>
        </service>
    </services>
</container>
