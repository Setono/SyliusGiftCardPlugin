<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusGiftCardPlugin\Operator\OrderGiftCardOperator"
                 class="Setono\SyliusGiftCardPlugin\Operator\OrderGiftCardOperator">
            <argument type="service" id="setono_sylius_gift_card.factory.gift_card"/>
            <argument type="service" id="doctrine"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Mailer\GiftCardEmailManagerInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Operator\GiftCardBalanceOperatorInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Resolver\GiftCardExpiryResolverInterface"/>
        </service>
        <!-- public because the winzou state machine calls it. The callbacks name this interface rather than the class,
             so a decorator of the interface runs there too -->
        <service id="Setono\SyliusGiftCardPlugin\Operator\OrderGiftCardOperatorInterface"
                 alias="Setono\SyliusGiftCardPlugin\Operator\OrderGiftCardOperator" public="true"/>
    </services>
</container>
