<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusGiftCardPlugin\Payment\GiftCardPaymentChecker"
                 class="Setono\SyliusGiftCardPlugin\Payment\GiftCardPaymentChecker">
            <argument>%setono_sylius_gift_card.redemption.payment_method_code%</argument>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Payment\GiftCardPaymentCheckerInterface"
                 alias="Setono\SyliusGiftCardPlugin\Payment\GiftCardPaymentChecker"/>

        <!-- What the gift cards have already paid on a placed order: the sum of its completed gift card payments -->
        <service id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardPaidAmountCalculator"
                 class="Setono\SyliusGiftCardPlugin\Calculator\GiftCardPaidAmountCalculator">
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Payment\GiftCardPaymentCheckerInterface"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardPaidAmountCalculatorInterface"
                 alias="Setono\SyliusGiftCardPlugin\Calculator\GiftCardPaidAmountCalculator"/>

        <service id="Setono\SyliusGiftCardPlugin\Provider\GiftCardPaymentMethodProvider"
                 class="Setono\SyliusGiftCardPlugin\Provider\GiftCardPaymentMethodProvider">
            <argument type="service" id="sylius.repository.payment_method"/>
            <argument type="service" id="sylius.factory.payment_method"/>
            <argument type="service" id="doctrine"/>
            <argument>%setono_sylius_gift_card.redemption.payment_method_code%</argument>
            <argument type="service" id="logger" on-invalid="null"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Provider\GiftCardPaymentMethodProviderInterface"
                 alias="Setono\SyliusGiftCardPlugin\Provider\GiftCardPaymentMethodProvider"/>

        <service id="Setono\SyliusGiftCardPlugin\Redemption\PaymentRedemptionMethod"
                 class="Setono\SyliusGiftCardPlugin\Redemption\PaymentRedemptionMethod">
            <argument type="service" id="sylius.order_processing.order_processor.composite"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculatorInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Operator\GiftCardBalanceOperatorInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Provider\GiftCardPaymentMethodProviderInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Payment\GiftCardPaymentCheckerInterface"/>
            <argument type="service" id="sylius.factory.payment"/>
            <argument type="service" id="sylius_abstraction.state_machine"/>
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Redemption\GiftCardRedemptionMethodInterface"
                 alias="Setono\SyliusGiftCardPlugin\Redemption\PaymentRedemptionMethod"/>
        <!-- public because commit()/rollback() are called from the winzou state machine; it points at the interface
             alias, not the class, so a decorator of the interface is what everything using this id gets -->
        <service id="setono_sylius_gift_card.redemption_method"
                 alias="Setono\SyliusGiftCardPlugin\Redemption\GiftCardRedemptionMethodInterface" public="true"/>

        <!--
            Size the gateway payment to (total - what the gift cards cover) for both of Sylius' payment processors.
            The checkout one works on carts, where the coverage comes from the gift cards' live balances; the
            after-checkout one works on placed orders, where the gift cards have already been redeemed and the
            coverage is what their completed payments say
        -->
        <service id="setono_sylius_gift_card.order_processor.gift_card_aware_payment.checkout"
                 class="Setono\SyliusGiftCardPlugin\OrderProcessor\GiftCardAwareOrderPaymentProcessor"
                 decorates="sylius.order_processing.order_payment_processor.checkout">
            <argument type="service" id="setono_sylius_gift_card.order_processor.gift_card_aware_payment.checkout.inner"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculatorInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardPaidAmountCalculatorInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Payment\GiftCardPaymentCheckerInterface"/>
            <argument>cart</argument>
        </service>

        <service id="setono_sylius_gift_card.order_processor.gift_card_aware_payment.after_checkout"
                 class="Setono\SyliusGiftCardPlugin\OrderProcessor\GiftCardAwareOrderPaymentProcessor"
                 decorates="sylius.order_processing.order_payment_processor.after_checkout">
            <argument type="service" id="setono_sylius_gift_card.order_processor.gift_card_aware_payment.after_checkout.inner"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculatorInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardPaidAmountCalculatorInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Payment\GiftCardPaymentCheckerInterface"/>
            <argument>new</argument>
        </service>

        <!-- Skip the checkout payment step when gift cards cover the whole order -->
        <service id="Setono\SyliusGiftCardPlugin\Checker\GiftCardAwarePaymentMethodSelectionRequirementChecker"
                 class="Setono\SyliusGiftCardPlugin\Checker\GiftCardAwarePaymentMethodSelectionRequirementChecker"
                 decorates="sylius.checker.order_payment_method_selection_requirement">
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Checker\GiftCardAwarePaymentMethodSelectionRequirementChecker.inner"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculatorInterface"/>
        </service>

        <!-- Hide the gift card payment method from checkout choices and default resolution -->
        <service id="Setono\SyliusGiftCardPlugin\Resolver\GiftCardAwarePaymentMethodsResolver"
                 class="Setono\SyliusGiftCardPlugin\Resolver\GiftCardAwarePaymentMethodsResolver"
                 decorates="sylius.payment_methods_resolver">
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Resolver\GiftCardAwarePaymentMethodsResolver.inner"/>
            <argument>%setono_sylius_gift_card.redemption.payment_method_code%</argument>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Resolver\GiftCardAwareDefaultPaymentMethodResolver"
                 class="Setono\SyliusGiftCardPlugin\Resolver\GiftCardAwareDefaultPaymentMethodResolver"
                 decorates="sylius.payment_method_resolver.default">
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Resolver\GiftCardAwareDefaultPaymentMethodResolver.inner"/>
            <argument type="service" id="sylius.repository.payment_method"/>
            <argument>%setono_sylius_gift_card.redemption.payment_method_code%</argument>
        </service>
    </services>
</container>
