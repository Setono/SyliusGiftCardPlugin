<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusGiftCardPlugin\OrderProcessor\GiftCardAdjustmentProcessor"
                 class="Setono\SyliusGiftCardPlugin\OrderProcessor\GiftCardAdjustmentProcessor">
            <argument type="service" id="translator"/>
            <argument type="service" id="sylius.custom_factory.adjustment"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculator"/>

            <tag name="sylius.order_processor" priority="5"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\Redemption\AdjustmentRedemptionMethod"
                 class="Setono\SyliusGiftCardPlugin\Redemption\AdjustmentRedemptionMethod">
            <argument type="service" id="sylius.order_processing.order_processor.composite"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculator"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Operator\GiftCardBalanceOperator"/>
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card"/>
        </service>

        <!-- public because commit()/rollback() are called from the winzou state machine -->
        <service id="setono_sylius_gift_card.redemption_method"
                 alias="Setono\SyliusGiftCardPlugin\Redemption\AdjustmentRedemptionMethod" public="true"/>
        <service id="Setono\SyliusGiftCardPlugin\Redemption\GiftCardRedemptionMethodInterface"
                 alias="Setono\SyliusGiftCardPlugin\Redemption\AdjustmentRedemptionMethod"/>
    </services>
</container>
