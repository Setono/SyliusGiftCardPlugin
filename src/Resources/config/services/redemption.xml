<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusGiftCardPlugin\Calculator\EligibleTotalCalculator"
                 class="Setono\SyliusGiftCardPlugin\Calculator\EligibleTotalCalculator"/>
        <service id="Setono\SyliusGiftCardPlugin\Calculator\EligibleTotalCalculatorInterface"
                 alias="Setono\SyliusGiftCardPlugin\Calculator\EligibleTotalCalculator"/>

        <service id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculator"
                 class="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculator">
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Calculator\EligibleTotalCalculatorInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Checker\GiftCardEligibilityCheckerInterface"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculatorInterface"
                 alias="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculator"/>

        <service id="Setono\SyliusGiftCardPlugin\Operator\GiftCardBalanceOperator"
                 class="Setono\SyliusGiftCardPlugin\Operator\GiftCardBalanceOperator">
            <argument type="service" id="setono_sylius_gift_card.factory.gift_card_transaction"/>
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card_transaction"/>
            <argument type="service" id="doctrine"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Operator\GiftCardBalanceOperatorInterface"
                 alias="Setono\SyliusGiftCardPlugin\Operator\GiftCardBalanceOperator"/>

        <service id="Setono\SyliusGiftCardPlugin\Checker\GiftCardEligibilityChecker"
                 class="Setono\SyliusGiftCardPlugin\Checker\GiftCardEligibilityChecker"/>
        <service id="Setono\SyliusGiftCardPlugin\Checker\GiftCardEligibilityCheckerInterface"
                 alias="Setono\SyliusGiftCardPlugin\Checker\GiftCardEligibilityChecker"/>

        <service id="Setono\SyliusGiftCardPlugin\StateMachine\GiftCardCoverageGuard"
                 class="Setono\SyliusGiftCardPlugin\StateMachine\GiftCardCoverageGuard">
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Checker\GiftCardEligibilityCheckerInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculatorInterface"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Payment\GiftCardPaymentCheckerInterface"/>
        </service>
        <!-- public because it is the guard the winzou state machine asks before completing a checkout. The guard
             callback names this interface rather than the class, so a decorator of the interface runs there too -->
        <service id="Setono\SyliusGiftCardPlugin\StateMachine\GiftCardCoverageGuardInterface"
                 alias="Setono\SyliusGiftCardPlugin\StateMachine\GiftCardCoverageGuard" public="true"/>

        <service id="Setono\SyliusGiftCardPlugin\Applicator\GiftCardApplicator"
                 class="Setono\SyliusGiftCardPlugin\Applicator\GiftCardApplicator">
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Generator\GiftCardCodeNormalizerInterface"/>
            <argument type="service" id="setono_sylius_gift_card.redemption_method"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Checker\GiftCardEligibilityCheckerInterface"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Applicator\GiftCardApplicatorInterface"
                 alias="Setono\SyliusGiftCardPlugin\Applicator\GiftCardApplicator"/>

        <service id="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardIsEligibleValidator"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardIsEligibleValidator">
            <argument type="service" id="sylius.context.cart"/>
            <argument type="service" id="Setono\SyliusGiftCardPlugin\Checker\GiftCardEligibilityCheckerInterface"/>
            <argument type="service" id="logger" on-invalid="null"/>

            <tag name="validator.constraint_validator"/>
        </service>
    </services>
</container>
