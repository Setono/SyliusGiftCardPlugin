<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="setono_sylius_gift_card.calculator.eligible_total"
                 class="Setono\SyliusGiftCardPlugin\Calculator\EligibleTotalCalculator"/>
        <service id="Setono\SyliusGiftCardPlugin\Calculator\EligibleTotalCalculatorInterface"
                 alias="setono_sylius_gift_card.calculator.eligible_total"/>

        <service id="setono_sylius_gift_card.calculator.gift_card_coverage"
                 class="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculator">
            <argument type="service" id="setono_sylius_gift_card.calculator.eligible_total"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Calculator\GiftCardCoverageCalculatorInterface"
                 alias="setono_sylius_gift_card.calculator.gift_card_coverage"/>

        <service id="setono_sylius_gift_card.operator.gift_card_balance"
                 class="Setono\SyliusGiftCardPlugin\Operator\GiftCardBalanceOperator">
            <argument type="service" id="setono_sylius_gift_card.factory.gift_card_transaction"/>
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card_transaction"/>
            <argument type="service" id="setono_sylius_gift_card.manager.gift_card_transaction"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Operator\GiftCardBalanceOperatorInterface"
                 alias="setono_sylius_gift_card.operator.gift_card_balance"/>

        <service id="setono_sylius_gift_card.applicator.gift_card"
                 class="Setono\SyliusGiftCardPlugin\Applicator\GiftCardApplicator">
            <argument type="service" id="setono_sylius_gift_card.repository.gift_card"/>
            <argument type="service" id="setono_sylius_gift_card.normalizer.gift_card_code"/>
            <argument type="service" id="setono_sylius_gift_card.redemption_method"/>
        </service>
        <service id="Setono\SyliusGiftCardPlugin\Applicator\GiftCardApplicatorInterface"
                 alias="setono_sylius_gift_card.applicator.gift_card"/>

        <service id="setono_sylius_gift_card.validator.gift_card_is_applicable"
                 class="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardIsApplicableValidator">
            <argument type="service" id="sylius.context.cart"/>

            <tag name="validator.constraint_validator"/>
        </service>
    </services>
</container>
