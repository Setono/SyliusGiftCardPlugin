<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusGiftCardPlugin\EventSubscriber\GiftCardDeletionSubscriber"
                 class="Setono\SyliusGiftCardPlugin\EventSubscriber\GiftCardDeletionSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="setono_sylius_gift_card.listener.gift_card_design_images_upload"
                 class="Sylius\Bundle\CoreBundle\EventListener\ImagesUploadListener"
                 parent="sylius.listener.images_upload">
            <argument type="service" id="sylius.image_uploader"/>

            <tag name="kernel.event_listener" event="setono_sylius_gift_card.gift_card_design.pre_create" method="uploadImages"/>
            <tag name="kernel.event_listener" event="setono_sylius_gift_card.gift_card_design.pre_update" method="uploadImages"/>
        </service>

        <service id="Setono\SyliusGiftCardPlugin\EventListener\PendingGiftCardCleanupListener"
                 class="Setono\SyliusGiftCardPlugin\EventListener\PendingGiftCardCleanupListener">
            <tag name="doctrine.event_listener" event="onFlush"/>
        </service>
    </services>
</container>
