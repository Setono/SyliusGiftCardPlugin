<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <mapped-superclass name="Setono\SyliusGiftCardPlugin\Model\GiftCard" table="setono_sylius_gift_card__gift_card">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="code" column="code" unique="true"/>
        <field name="enabled" column="enabled" type="boolean"/>
        <field name="amount" column="amount" type="integer"/>
        <field name="initialAmount" column="initial_amount" type="integer"/>
        <field name="currencyCode" column="currency_code" length="3"/>
        <field name="deliveryType" column="delivery_type" type="string"
               enum-type="Setono\SyliusGiftCardPlugin\Model\GiftCardDeliveryType"/>
        <field name="customMessage" column="custom_message" type="text" nullable="true"/>
        <field name="expiresAt" column="expires_at" type="datetime" nullable="true"/>
        <field name="version" column="version" type="integer" version="true"/>

        <field name="createdAt" column="created_at" type="datetime">
            <gedmo:timestampable on="create"/>
        </field>

        <field name="updatedAt" column="updated_at" type="datetime" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>

        <many-to-one field="customer" target-entity="Sylius\Component\Customer\Model\CustomerInterface">
            <join-column name="customer_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>

        <many-to-one field="channel" target-entity="Sylius\Component\Channel\Model\ChannelInterface">
            <join-column name="channel_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="design" target-entity="Setono\SyliusGiftCardPlugin\Model\GiftCardDesignInterface">
            <join-column name="design_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>

        <!-- The order item unit where this gift card was bought. SET NULL so purging old orders never deletes live cards -->
        <one-to-one field="orderItemUnit" target-entity="Sylius\Component\Order\Model\OrderItemUnitInterface"
                    inversed-by="giftCard">
            <join-column name="order_item_unit_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
        </one-to-one>

        <!-- Orders where this gift card was applied / redeemed -->
        <many-to-many field="appliedOrders" target-entity="Sylius\Component\Order\Model\OrderInterface"
                      mapped-by="giftCards"/>

        <one-to-many field="transactions" target-entity="Setono\SyliusGiftCardPlugin\Model\GiftCardTransactionInterface"
                     mapped-by="giftCard">
            <cascade>
                <cascade-persist/>
            </cascade>
            <order-by>
                <order-by-field name="id" direction="ASC"/>
            </order-by>
        </one-to-many>
    </mapped-superclass>
</doctrine-mapping>
