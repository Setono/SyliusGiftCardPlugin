<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">

    <class name="Setono\SyliusGiftCardPlugin\Controller\Action\Admin\AdjustGiftCardBalanceCommand">
        <constraint name="Setono\SyliusGiftCardPlugin\Validator\Constraints\BalanceAdjustmentIsEligible">
            <option name="groups">setono_sylius_gift_card</option>
        </constraint>
        <property name="amount">
            <constraint name="NotNull">
                <option name="message">setono_sylius_gift_card.adjust_gift_card_balance_command.amount.not_blank</option>
                <option name="groups">setono_sylius_gift_card</option>
            </constraint>
            <constraint name="NotEqualTo">
                <option name="value">0</option>
                <option name="message">setono_sylius_gift_card.adjust_gift_card_balance_command.amount.not_zero</option>
                <option name="groups">setono_sylius_gift_card</option>
            </constraint>
        </property>
        <property name="reason">
            <constraint name="NotBlank">
                <option name="message">setono_sylius_gift_card.adjust_gift_card_balance_command.reason.not_blank</option>
                <option name="groups">setono_sylius_gift_card</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
