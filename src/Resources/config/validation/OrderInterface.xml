<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">

    <!-- The order class is the application's, and implements this interface: the validator merges the constraints of
         the interfaces a class implements into the class's own. The cart page's form validates the cart in Sylius'
         group (sylius.form.type.cart.validation_groups) -->
    <class name="Setono\SyliusGiftCardPlugin\Model\OrderInterface">
        <constraint name="Setono\SyliusGiftCardPlugin\Validator\Constraints\GiftCardQuantityFitsCart">
            <option name="groups">sylius</option>
        </constraint>
    </class>
</constraint-mapping>
