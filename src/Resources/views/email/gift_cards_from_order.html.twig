{# Emails are rendered outside of a request, so every translation takes localeCode explicitly, the way
   Sylius' own email templates do. Without it the translator's current locale wins: the admin's UI locale
   when a card is resent from the admin, the default locale from the CLI or a webhook. #}
{% extends '@SyliusShop/Email/layout.html.twig' %}

{% block subject %}{{ 'setono_sylius_gift_card.email.your_gift_cards_you_bought_in_the_order'|trans({}, 'messages', localeCode) }}{% endblock %}

{% block content %}
    <p>{{ 'setono_sylius_gift_card.email.your_gift_cards_you_bought_in_the_order'|trans({}, 'messages', localeCode) }} {{ order.number }}:</p>

    {{ include('@SetonoSyliusGiftCardPlugin/email/_gift_cards.html.twig') }}
{% endblock %}
