{% extends '@SyliusAdmin/layout.html.twig' %}

{% import '@SyliusUi/Macro/headers.html.twig' as headers %}
{% import '@SyliusAdmin/Macro/breadcrumb.html.twig' as breadcrumb %}

{% set giftCard = resource %}

{% block title %}{{ giftCard.code|setono_gift_card_format_code }} {{ parent() }}{% endblock %}

{% block content %}
    <div class="ui stackable grid">
        <div class="column">
            {{ headers.default(giftCard.code|setono_gift_card_format_code, 'gift', 'setono_sylius_gift_card.ui.gift_card'|trans) }}

            {% set breadcrumbs = [
                { label: 'sylius.ui.administration'|trans, url: path('sylius_admin_dashboard') },
                { label: 'setono_sylius_gift_card.ui.gift_cards'|trans, url: path('setono_sylius_gift_card_admin_gift_card_index') },
                { label: giftCard.code|setono_gift_card_format_code }
            ] %}
            {{ breadcrumb.crumble(breadcrumbs) }}
        </div>
    </div>

    <div class="ui stackable two column grid">
        <div class="column">
            <div class="ui segment">
                <h4 class="ui dividing header">{{ 'sylius.ui.details'|trans }}</h4>
                <table class="ui very basic table">
                    <tbody>
                        <tr>
                            <td><strong>{{ 'sylius.ui.code'|trans }}</strong></td>
                            <td>{{ giftCard.code|setono_gift_card_format_code }}</td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'sylius.ui.status'|trans }}</strong></td>
                            <td>{% include '@SetonoSyliusGiftCardPlugin/admin/gift_card/_status.html.twig' with {'giftCard': giftCard} only %}</td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'sylius.ui.enabled'|trans }}</strong></td>
                            <td>{% include '@SyliusUi/Grid/Field/enabled.html.twig' with {'data': giftCard.enabled} %}</td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'sylius.ui.amount'|trans }}</strong></td>
                            <td>{{ giftCard.amount|sylius_format_money(giftCard.currencyCode, sylius.localeCode) }}</td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'setono_sylius_gift_card.ui.initial_amount'|trans }}</strong></td>
                            <td>{{ giftCard.initialAmount|sylius_format_money(giftCard.currencyCode, sylius.localeCode) }}</td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'setono_sylius_gift_card.ui.delivery_type'|trans }}</strong></td>
                            <td>{{ ('setono_sylius_gift_card.ui.delivery_type_' ~ giftCard.deliveryType.value)|trans }}</td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'sylius.ui.channel'|trans }}</strong></td>
                            <td>{{ giftCard.channel ? giftCard.channel.name : '-' }}</td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'sylius.ui.customer'|trans }}</strong></td>
                            {# The grid's customer column, so both mail the customer from the email and open them from the icon #}
                            <td>{% include '@SetonoSyliusGiftCardPlugin/admin/gift_card/grid/field/customer.html.twig' with {'data': giftCard.customer} only %}</td>
                        </tr>
                        {# The admin has no page for a cart, so an order is only linked once it is placed #}
                        {% set cartState = constant('Sylius\\Component\\Order\\Model\\OrderInterface::STATE_CART') %}
                        <tr>
                            <td><strong>{{ 'setono_sylius_gift_card.ui.bought_with_order'|trans }}</strong></td>
                            <td>
                                {% set boughtWith = giftCard.order %}
                                {% if boughtWith is null %}
                                    -
                                {% elseif boughtWith.state == cartState %}
                                    {{ 'setono_sylius_gift_card.ui.in_cart'|trans }}
                                {% else %}
                                    <a href="{{ path('sylius_admin_order_show', {'id': boughtWith.id}) }}">#{{ boughtWith.number }}</a>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'setono_sylius_gift_card.ui.applied_to_orders'|trans }}</strong></td>
                            <td>
                                {% for appliedOrder in giftCard.appliedOrders|filter(order => order.state != cartState)|sort((a, b) => a.id <=> b.id) %}
                                    <a href="{{ path('sylius_admin_order_show', {'id': appliedOrder.id}) }}">#{{ appliedOrder.number }}</a>{% if not loop.last %}, {% endif %}
                                {% else %}
                                    -
                                {% endfor %}
                            </td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'setono_sylius_gift_card.ui.design'|trans }}</strong></td>
                            <td>
                                {% set design = giftCard.design %}
                                {% if design is null %}
                                    -
                                {% else %}
                                    {# A design has no page of its own but its edit page, which shows its images #}
                                    <a href="{{ path('setono_sylius_gift_card_admin_gift_card_design_update', {'id': design.id}) }}">
                                        {% if design.frontImage is not null and design.frontImage.path is not null %}
                                            <img class="ui small rounded image" src="{{ design.frontImage.path|imagine_filter('setono_sylius_gift_card_design_thumbnail') }}" alt="">
                                        {% endif %}
                                        {{ design.name }}
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'setono_sylius_gift_card.form.gift_card.custom_message'|trans }}</strong></td>
                            {# The message keeps the line breaks it was written with, as on the card; nl2br escapes it first #}
                            <td>{{ giftCard.customMessage ? giftCard.customMessage|nl2br : '-' }}</td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'setono_sylius_gift_card.form.gift_card.expires_at'|trans }}</strong></td>
                            <td>{{ giftCard.expiresAt ? giftCard.expiresAt|date('Y-m-d') : '-' }}</td>
                        </tr>
                        <tr>
                            <td><strong>{{ 'sylius.ui.created_at'|trans }}</strong></td>
                            <td>{{ giftCard.createdAt ? giftCard.createdAt|date('Y-m-d H:i') : '-' }}</td>
                        </tr>
                    </tbody>
                </table>

                <a href="{{ path('setono_sylius_gift_card_admin_gift_card_update', {'id': giftCard.id}) }}" class="ui labeled icon button">
                    <i class="pencil icon"></i>{{ 'sylius.ui.edit'|trans }}
                </a>
                <a href="{{ path('setono_sylius_gift_card_admin_gift_card_adjust_balance', {'id': giftCard.id}) }}" class="ui labeled icon button">
                    <i class="balance scale icon"></i>{{ 'setono_sylius_gift_card.ui.adjust_balance'|trans }}
                </a>
                <a href="{{ path('setono_sylius_gift_card_admin_gift_card_pdf', {'id': giftCard.id}) }}" class="ui labeled icon button" target="_blank">
                    <i class="download icon"></i>{{ 'setono_sylius_gift_card.ui.download_pdf'|trans }}
                </a>
                {# Sending reaches the customer, so it is a POST carrying a CSRF token rather than a link:
                   a browser prefetch would otherwise send the card behind the admin's back. Only a card the
                   customer can use is offered, as the email on creation is only sent for one #}
                {% if giftCard.usable %}
                    <form action="{{ path('setono_sylius_gift_card_admin_gift_card_send_email', {'id': giftCard.id}) }}" method="post" style="display: contents;">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token(constant('Setono\\SyliusGiftCardPlugin\\Controller\\Action\\Admin\\SendGiftCardEmailAction::CSRF_TOKEN_ID')) }}">
                        <button type="submit" class="ui labeled icon button">
                            <i class="envelope icon"></i>{{ 'setono_sylius_gift_card.ui.send_email'|trans }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>

        <div class="column">
            <div class="ui segment">
                <h4 class="ui dividing header">{{ 'setono_sylius_gift_card.ui.transactions'|trans }}</h4>

                {% if giftCard.transactions is empty %}
                    <p class="ui gray text">{{ 'setono_sylius_gift_card.ui.no_transactions'|trans }}</p>
                {% else %}
                    <table class="ui celled table">
                        <thead>
                            <tr>
                                <th>{{ 'sylius.ui.date'|trans }}</th>
                                <th>{{ 'sylius.ui.type'|trans }}</th>
                                <th class="right aligned">{{ 'sylius.ui.amount'|trans }}</th>
                                <th>{{ 'setono_sylius_gift_card.form.adjust_balance.reason'|trans }}</th>
                                <th>{{ 'sylius.ui.order'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for transaction in giftCard.transactions %}
                                <tr>
                                    <td>{{ transaction.createdAt ? transaction.createdAt|date('Y-m-d H:i') : '-' }}</td>
                                    <td>{{ ('setono_sylius_gift_card.ui.transaction_type_' ~ transaction.type)|trans }}</td>
                                    <td class="right aligned">
                                        {{ transaction.amount|sylius_format_money(giftCard.currencyCode, sylius.localeCode) }}
                                    </td>
                                    <td>{{ transaction.reason ?: '-' }}</td>
                                    <td>
                                        {% if transaction.order %}
                                            <a href="{{ path('sylius_admin_order_show', {'id': transaction.order.id}) }}">#{{ transaction.order.number }}</a>
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
