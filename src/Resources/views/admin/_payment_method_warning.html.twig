{# Rendered above the header of the gift card and payment method indexes (and with the rest of the setup warning on
   the designs index) while the shop sells gift cards without the payment method gift card payments are made with #}
{% set payment_method_code = setono_gift_card_missing_payment_method_code() %}
{% if payment_method_code is not null %}
    <div class="ui error message" data-test-gift-card-payment-method-warning-message>
        <div class="header">{{ 'setono_sylius_gift_card.ui.payment_method_warning.header'|trans }}</div>
        <p>{{ 'setono_sylius_gift_card.ui.payment_method_warning.explanation'|trans }}</p>
        <ul class="list">
            <li>
                <a href="{{ path('sylius_admin_payment_method_create', {'factory': 'offline'}) }}">{{ 'setono_sylius_gift_card.ui.payment_method_warning.create_payment_method'|trans }}</a>
                {{ 'setono_sylius_gift_card.ui.payment_method_warning.create_payment_method_suffix'|trans }}
                <code>{{ payment_method_code }}</code>, {{ 'setono_sylius_gift_card.ui.payment_method_warning.or'|trans }}
            </li>
            <li>
                {{ 'setono_sylius_gift_card.ui.payment_method_warning.run_command'|trans }}
                <code>bin/console setono:gift-card:create-payment-method</code>
            </li>
        </ul>
    </div>
{% endif %}
