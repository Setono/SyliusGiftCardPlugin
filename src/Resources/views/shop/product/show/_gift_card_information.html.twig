{# The gift card fields on Sylius' own product page, on its sylius.shop.product.show.add_to_cart_form event. The shop
   shows a gift card product on the plugin's page (@SetonoSyliusGiftCardPlugin/shop/product/show.html.twig) instead,
   so this is only rendered where Sylius' add to cart form is rendered for one some other way, and keeps the product
   buyable there. It is made of the same parts as the plugin's page #}
{% if form.giftCardInformation is defined %}
    {% set channel = sylius.channel %}

    {# The live preview script works within this element. An empty currency makes the preview format a plain number
       rather than pretend the shop sells in dollars #}
    <div id="setono-gift-card-information"
         class="ui segment"
         data-preview-message-placeholder="{{ 'setono_sylius_gift_card.ui.your_message_here'|trans }}"
         data-currency="{{ channel and channel.baseCurrency ? channel.baseCurrency.code : '' }}"
         data-locale="{{ app.request.locale|replace({'_': '-'}) }}">
        <h4 class="ui dividing header">{{ 'setono_sylius_gift_card.ui.gift_card'|trans }}</h4>

        {{ include('@SetonoSyliusGiftCardPlugin/shop/product/show/_preview.html.twig') }}
        {{ include('@SetonoSyliusGiftCardPlugin/shop/product/show/add_to_cart_form/_amount.html.twig') }}
        {{ include('@SetonoSyliusGiftCardPlugin/shop/product/show/add_to_cart_form/_design.html.twig') }}
        {{ include('@SetonoSyliusGiftCardPlugin/shop/product/show/add_to_cart_form/_message.html.twig') }}
    </div>

    <script defer src="{{ asset('bundles/setonosyliusgiftcardplugin/js/product-gift-card.js') }}"></script>
    <link rel="stylesheet" href="{{ asset('bundles/setonosyliusgiftcardplugin/css/product-gift-card.css') }}"/>
{% endif %}
