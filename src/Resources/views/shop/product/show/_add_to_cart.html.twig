{# Sylius' add to cart form, built and handled by Sylius as on any product page: its partial route makes the form
   (the plugin's form type extension adds the gift card fields to it) and renders it with the plugin's template, and
   the form posts to Sylius' cart route with its CSRF token. What is out of stock gets Sylius' message instead #}
{% if product.enabledVariants.empty() or product.simple and not sylius_inventory_is_available(product.enabledVariants.first) %}
    {% include '@SyliusShop/Product/Show/_outOfStock.html.twig' %}
{% else %}
    {{ render(url('sylius_shop_partial_cart_add_item', {
        'template': '@SetonoSyliusGiftCardPlugin/shop/product/show/_add_to_cart_form.html.twig',
        'productId': product.id,
    })) }}
{% endif %}
